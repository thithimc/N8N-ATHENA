{
  "name": "Avis Google - Champs-sur-Marne (migré depuis Zapier)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        },
        "event": "reviewAdded",
        "account": "",
        "location": ""
      },
      "id": "trigger-gbp-new-review",
      "name": "Nouvel avis Google",
      "type": "n8n-nodes-base.googleBusinessProfileTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": {
        "googleBusinessProfileOAuth2Api": {
          "id": "REMPLACER_ID_CREDENTIAL",
          "name": "Google Business Profile - Thibaud"
        }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#avis-google"
        },
        "text": "=⭐ *Nouvel avis Google !*\n👤 {{ $json.reviewer?.displayName || 'Anonyme' }}\n⭐ {{ ({ONE:1,TWO:2,THREE:3,FOUR:4,FIVE:5})[$json.starRating] || $json.starRating }}/5\n💬 {{ (() => { const c = ($json.comment || '').trim(); if (!c) return '(avis sans commentaire)'; if (c.includes('(Original)')) return c.split('(Original)').pop().trim(); return c.split('(Translated by Google)')[0].trim(); })() }}\n📅 {{ $json.createTime }}",
        "otherOptions": {}
      },
      "id": "action-slack-message",
      "name": "Envoyer message Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [220, 0],
      "credentials": {
        "slackOAuth2Api": {
          "id": "REMPLACER_ID_CREDENTIAL",
          "name": "Slack - Athena"
        }
      }
    }
  ],
  "connections": {
    "Nouvel avis Google": {
      "main": [
        [
          {
            "node": "Envoyer message Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
